# TradeConnect frontend — public runtime config.
# All vars are NEXT_PUBLIC_* (exposed to the browser). Copy to `.env.local` and fill in.

# API mode: 'live' calls the gateway, 'mock' runs a fully offline simulation.
NEXT_PUBLIC_API_MODE=live

# NestJS gateway base URL (everything is served under /api/v1).
# Local:    http://localhost:3000/api/v1
# Deployed: https://tc-gateway.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Demo account auto-login credentials (client logs in / self-registers, caches JWT).
NEXT_PUBLIC_DEMO_EMAIL=demo@tradeconnect.id
NEXT_PUBLIC_DEMO_PASSWORD=DemoPass123!

# Seeded demo product UUID used by generate-reply pricing context.
NEXT_PUBLIC_DEMO_PRODUCT_ID=2914e55a-8f5c-495b-8c34-e7b10670bd73

# Google Maps JavaScript API browser key (Market Intelligence map).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID — REQUIRED by AdvancedMarkerElement.
# 'DEMO_MAP_ID' works for development. In production, create a Cloud map ID
# (Google Cloud Console → Maps → Map Management); associating a map style with it
# also restores custom map styling (which inline JSON styles no longer control).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
